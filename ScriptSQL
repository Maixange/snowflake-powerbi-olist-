"
---------------------------------------Data Quality Check-------------------------------------
"
-- 1. Pas de perte de lignes entre RAW et MART 112650 = 112650
SELECT
  (SELECT COUNT(*) FROM OLIST_DB.RAW.ORDER_ITEMS) AS raw_items,
  (SELECT COUNT(*) FROM OLIST_DB.MART.FACT_ORDERS) AS fact_rows;

-- 2. Unicité de la clé de la fact (doit retourner 0 ligne) 0 lignes
SELECT order_id, order_item_id, COUNT(*) AS n
FROM OLIST_DB.MART.FACT_ORDERS
GROUP BY 1, 2 HAVING COUNT(*) > 1;

-- 3. Unicité des clés des dimensions (chacune doit retourner 0 ligne) 0 et 0 et 0
SELECT customer_id, COUNT(*) FROM OLIST_DB.MART.DIM_CUSTOMER GROUP BY 1 HAVING COUNT(*) > 1;
SELECT product_id,  COUNT(*) FROM OLIST_DB.MART.DIM_PRODUCT  GROUP BY 1 HAVING COUNT(*) > 1;
SELECT seller_id,   COUNT(*) FROM OLIST_DB.MART.DIM_SELLER   GROUP BY 1 HAVING COUNT(*) > 1;

-- 4. Intégrité référentielle : faits sans dimension correspondante (doit retourner 0) 0 et 0 et 0
SELECT COUNT(*) AS orphan_customers FROM OLIST_DB.MART.FACT_ORDERS f
LEFT JOIN OLIST_DB.MART.DIM_CUSTOMER d ON f.customer_id = d.customer_id WHERE d.customer_id IS NULL;
SELECT COUNT(*) AS orphan_products FROM OLIST_DB.MART.FACT_ORDERS f
LEFT JOIN OLIST_DB.MART.DIM_PRODUCT d ON f.product_id = d.product_id WHERE d.product_id IS NULL;
SELECT COUNT(*) AS orphan_sellers FROM OLIST_DB.MART.FACT_ORDERS f
LEFT JOIN OLIST_DB.MART.DIM_SELLER d ON f.seller_id = d.seller_id WHERE d.seller_id IS NULL;

-- 5. Taux de valeurs nulles sur les colonnes clés 
SELECT
  COUNT_IF(purchase_ts IS NULL)  AS null_purchase_ts,  --0
  COUNT_IF(price IS NULL)        AS null_price,  --0
  COUNT_IF(review_score IS NULL) AS null_review, --0
  COUNT_IF(delivered_ts IS NULL) AS not_delivered  --2454
FROM OLIST_DB.MART.FACT_ORDERS;

SELECT
  is_late,
  COUNT(*) AS nb_lignes,
  ROUND(AVG(review_score), 2) AS note_moyenne
FROM OLIST_DB.MART.FACT_ORDERS
WHERE is_late IS NOT NULL
GROUP BY is_late;
