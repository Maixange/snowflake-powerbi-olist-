USE SCHEMA OLIST_DB.MART;
"
-------------------------------------------Table dimension-------------------------------------------------
"
CREATE OR REPLACE TABLE DIM_CUSTOMER AS
SELECT
  customer_id,
  customer_unique_id,
  customer_city,
  UPPER(customer_state) AS customer_state
FROM OLIST_DB.RAW.CUSTOMERS;

CREATE OR REPLACE TABLE DIM_SELLER AS
SELECT
  seller_id,
  seller_city,
  UPPER(seller_state) AS seller_state
FROM OLIST_DB.RAW.SELLERS;

CREATE OR REPLACE TABLE DIM_PRODUCT AS
SELECT
  p.product_id,
  COALESCE(t.product_category_name_english, p.product_category_name, 'unknown') AS category_name,
  TRY_TO_NUMBER(p.product_weight_g) AS weight_g,
  TRY_TO_NUMBER(p.product_photos_qty) AS photos_qty
FROM OLIST_DB.RAW.PRODUCTS p
LEFT JOIN OLIST_DB.RAW.CATEGORY_TRANSLATION t
  ON p.product_category_name = t.product_category_name;

"
-------------------------------------------Table de faits-------------------------------------------------
"
CREATE OR REPLACE TABLE FACT_ORDERS AS
WITH reviews AS (
  SELECT
    order_id,
    AVG(TRY_TO_NUMBER(review_score)) AS review_score
  FROM OLIST_DB.RAW.ORDER_REVIEWS
  GROUP BY order_id
),
orders AS (
  SELECT
    order_id,
    customer_id,
    order_status,
    TRY_TO_TIMESTAMP(order_purchase_timestamp)       AS purchase_ts,
    TRY_TO_TIMESTAMP(order_delivered_customer_date)  AS delivered_ts,
    TRY_TO_TIMESTAMP(order_estimated_delivery_date)  AS estimated_ts
  FROM OLIST_DB.RAW.ORDERS
)
SELECT
  i.order_id,
  TRY_TO_NUMBER(i.order_item_id)                    AS order_item_id,
  o.customer_id,
  i.product_id,
  i.seller_id,
  o.order_status,
  o.purchase_ts,
  DATE(o.purchase_ts)                               AS purchase_date,
  o.delivered_ts,
  o.estimated_ts,
  TRY_TO_DECIMAL(i.price, 10, 2)                    AS price,
  TRY_TO_DECIMAL(i.freight_value, 10, 2)            AS freight_value,
  TRY_TO_DECIMAL(i.price, 10, 2)
    + TRY_TO_DECIMAL(i.freight_value, 10, 2)        AS total_amount,
  DATEDIFF('day', o.purchase_ts, o.delivered_ts)    AS delivery_days,
  DATEDIFF('day', o.estimated_ts, o.delivered_ts)   AS delay_days,
  CASE
    WHEN o.delivered_ts IS NULL THEN NULL
    WHEN o.delivered_ts > o.estimated_ts THEN 1
    ELSE 0
  END                                               AS is_late,
  r.review_score
FROM OLIST_DB.RAW.ORDER_ITEMS i
JOIN orders o       ON i.order_id = o.order_id
LEFT JOIN reviews r ON i.order_id = r.order_id;

